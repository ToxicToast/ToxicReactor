# Template for /opt/toxicreactor/.env on the VPS.
# Copy this file to the server once, fill in real values, chmod 600.
# It is read twice: by docker compose for ${...} interpolation, and by the
# container itself via env_file. It is never committed and never sent through CI.

# --- compose interpolation ---
STACK_NAME=toxicreactor
# Host-side port, bound to 127.0.0.1 only. Point your reverse proxy here.
HOST_PORT=3000

# --- application env ---
NODE_ENV=production
PORT=3000
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/toxicreactor
# JWT_SECRET=
